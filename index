<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Leaf House Cafe — a place to drift</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=DM+Serif+Display:ital@0;1&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --ink: #1a1a14;
    --cream: #f5f0e8;
    --cream-dark: #ede7d9;
    --forest: #2d4a30;
    --forest-light: #3d6342;
    --moss: #5c7a4e;
    --gold: #b8965a;
    --gold-light: #d4ae78;
    --sage: #a8b89a;
    --mist: #e8ede4;
    --white: #fdfaf5;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; font-size: 16px; }

  body {
    background: var(--cream);
    color: var(--ink);
    font-family: 'Jost', sans-serif;
    font-weight: 300;
    overflow-x: hidden;
    cursor: default;
  }

  /* ─── NOISE TEXTURE OVERLAY ─── */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 9999;
    opacity: 0.4;
  }

  /* ─── NAV ─── */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 3rem;
    mix-blend-mode: normal;
    transition: background 0.5s, backdrop-filter 0.5s;
  }
  nav.scrolled {
    background: rgba(245,240,232,0.88);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(184,150,90,0.15);
  }
  .nav-logo {
    font-family: 'DM Serif Display', serif;
    font-size: 1.1rem;
    letter-spacing: 0.08em;
    color: var(--white);
    text-decoration: none;
    transition: color 0.4s;
  }
  nav.scrolled .nav-logo { color: var(--forest); }

  .nav-links {
    display: flex;
    gap: 2.5rem;
    list-style: none;
  }
  .nav-links a {
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(253,250,245,0.8);
    text-decoration: none;
    transition: color 0.3s;
  }
  .nav-links a:hover { color: var(--gold-light); }
  nav.scrolled .nav-links a { color: var(--forest); }
  nav.scrolled .nav-links a:hover { color: var(--gold); }

  .nav-cta {
    font-family: 'Jost', sans-serif;
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-light) !important;
    border: 1px solid var(--gold-light);
    padding: 0.55rem 1.4rem;
    border-radius: 2px;
    text-decoration: none;
    transition: background 0.3s, color 0.3s !important;
  }
  .nav-cta:hover { background: var(--gold); color: var(--white) !important; border-color: var(--gold); }

  /* ─── HERO ─── */
  .hero {
    position: relative;
    height: 100vh;
    min-height: 700px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--forest);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse 80% 60% at 60% 40%, rgba(92,122,78,0.35) 0%, transparent 70%),
      radial-gradient(ellipse 50% 80% at 15% 70%, rgba(45,74,48,0.8) 0%, transparent 60%),
      linear-gradient(160deg, #1a2e1c 0%, #2d4a30 35%, #1e3820 65%, #141f15 100%);
  }

  /* Animated leaf drifts */
  .leaf-drift {
    position: absolute;
    pointer-events: none;
    opacity: 0;
    animation: leafFall linear infinite;
  }
  .leaf-drift svg { display: block; }

  @keyframes leafFall {
    0% { opacity: 0; transform: translateY(-60px) rotate(0deg) translateX(0); }
    10% { opacity: 0.35; }
    90% { opacity: 0.2; }
    100% { opacity: 0; transform: translateY(110vh) rotate(480deg) translateX(80px); }
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 2rem;
  }

  .hero-eyebrow {
    font-family: 'Jost', sans-serif;
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--gold-light);
    margin-bottom: 2rem;
    opacity: 0;
    animation: fadeUp 1s ease 0.3s forwards;
  }

  .hero-title {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(4rem, 10vw, 9rem);
    color: var(--white);
    line-height: 0.9;
    margin-bottom: 0.3rem;
    letter-spacing: -0.01em;
    opacity: 0;
    animation: fadeUp 1s ease 0.6s forwards;
  }
  .hero-title em {
    font-style: italic;
    color: var(--sage);
    display: block;
  }

  .hero-tagline {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: clamp(1.1rem, 2.5vw, 1.6rem);
    color: var(--sage);
    letter-spacing: 0.05em;
    margin-top: 1.5rem;
    opacity: 0;
    animation: fadeUp 1s ease 0.9s forwards;
  }

  .hero-divider {
    width: 1px;
    height: 60px;
    background: linear-gradient(to bottom, var(--gold), transparent);
    margin: 2.5rem auto;
    opacity: 0;
    animation: fadeIn 1s ease 1.2s forwards;
  }

  .hero-meta {
    display: flex;
    justify-content: center;
    gap: 3rem;
    opacity: 0;
    animation: fadeUp 1s ease 1.4s forwards;
  }
  .hero-meta-item {
    text-align: center;
  }
  .hero-meta-label {
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold-light);
    display: block;
    margin-bottom: 0.3rem;
  }
  .hero-meta-value {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    color: var(--cream);
  }

  .hero-scroll {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    opacity: 0;
    animation: fadeIn 1.2s ease 2s forwards;
    cursor: pointer;
  }
  .hero-scroll span {
    font-size: 0.6rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--sage);
  }
  .scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, var(--sage), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }
  @keyframes scrollPulse {
    0%, 100% { transform: scaleY(1); opacity: 0.6; }
    50% { transform: scaleY(0.6); opacity: 1; }
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* ─── SECTION BASE ─── */
  section { position: relative; }

  .section-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ─── INTRO STRIP ─── */
  .intro-strip {
    background: var(--forest);
    padding: 4rem 0;
    overflow: hidden;
  }
  .intro-strip-track {
    display: flex;
    gap: 3rem;
    white-space: nowrap;
    animation: marquee 20s linear infinite;
  }
  .intro-strip-item {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 1.4rem;
    color: var(--sage);
    flex-shrink: 0;
  }
  .intro-strip-dot {
    color: var(--gold);
    margin: 0 1rem;
  }
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* ─── STORY ─── */
  .story {
    padding: 8rem 0;
    background: var(--white);
  }
  .story-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
    align-items: center;
  }
  .story-visual {
    position: relative;
    height: 580px;
  }
  .story-card {
    position: absolute;
    border-radius: 3px;
    overflow: hidden;
  }
  .story-card-main {
    width: 72%;
    height: 440px;
    top: 0; left: 0;
    background: linear-gradient(145deg, #2d4a30, #3d6342);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .story-card-accent {
    width: 55%;
    height: 260px;
    bottom: 0; right: 0;
    background: linear-gradient(145deg, #b8965a, #8a6e3a);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .leaf-icon-lg {
    opacity: 0.25;
  }
  .story-float-badge {
    position: absolute;
    top: 50%;
    right: -30px;
    transform: translateY(-50%);
    background: var(--cream);
    border: 1px solid var(--gold-light);
    padding: 1.5rem;
    text-align: center;
    width: 120px;
    z-index: 2;
    box-shadow: 0 20px 60px rgba(0,0,0,0.1);
  }
  .story-float-num {
    font-family: 'DM Serif Display', serif;
    font-size: 2.5rem;
    color: var(--gold);
    display: block;
    line-height: 1;
  }
  .story-float-label {
    font-size: 0.6rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--forest);
    margin-top: 0.4rem;
    display: block;
  }

  .section-kicker {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1rem;
    display: block;
  }
  .section-title {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    color: var(--forest);
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }
  .section-title em {
    font-style: italic;
    color: var(--gold);
  }
  .section-body {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.2rem;
    line-height: 1.8;
    color: #4a4a3a;
    margin-bottom: 1.5rem;
  }
  .text-link {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--forest);
    text-decoration: none;
    border-bottom: 1px solid var(--gold);
    padding-bottom: 2px;
    transition: color 0.3s, border-color 0.3s;
  }
  .text-link:hover { color: var(--gold); }

  /* ─── SIGNATURE ─── */
  .signature {
    padding: 8rem 0;
    background: var(--forest);
    overflow: hidden;
  }
  .signature-header {
    text-align: center;
    margin-bottom: 5rem;
  }
  .signature-header .section-title { color: var(--cream); }
  .signature-header .section-title em { color: var(--gold-light); }
  .signature-header .section-kicker { color: var(--sage); }

  .drinks-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
  }
  .drink-card {
    position: relative;
    overflow: hidden;
    cursor: pointer;
  }
  .drink-card-inner {
    padding: 3rem 2.5rem;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    height: 100%;
    transition: background 0.5s;
    min-height: 340px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .drink-card:hover .drink-card-inner {
    background: rgba(184,150,90,0.1);
    border-color: rgba(184,150,90,0.3);
  }
  .drink-number {
    font-family: 'DM Serif Display', serif;
    font-size: 5rem;
    color: rgba(255,255,255,0.04);
    position: absolute;
    top: 1rem;
    right: 1.5rem;
    line-height: 1;
    transition: color 0.5s;
  }
  .drink-card:hover .drink-number { color: rgba(184,150,90,0.12); }
  .drink-emoji {
    font-size: 2.5rem;
    margin-bottom: 1.5rem;
    display: block;
  }
  .drink-name {
    font-family: 'DM Serif Display', serif;
    font-size: 1.5rem;
    color: var(--cream);
    margin-bottom: 0.6rem;
    line-height: 1.2;
  }
  .drink-name em { font-style: italic; color: var(--gold-light); }
  .drink-desc {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 0.95rem;
    color: var(--sage);
    line-height: 1.6;
    margin-bottom: 1.2rem;
  }
  .drink-price {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: var(--gold);
  }

  /* ─── EXPERIENCE ─── */
  .experience {
    padding: 9rem 0;
    background: var(--cream-dark);
  }
  .experience-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 5rem;
    align-items: start;
  }
  .experience-text { padding-top: 2rem; }
  .pillars {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin-top: 3rem;
  }
  .pillar {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    opacity: 0;
    transform: translateX(-20px);
    transition: opacity 0.7s, transform 0.7s;
  }
  .pillar.visible { opacity: 1; transform: translateX(0); }
  .pillar-num {
    font-family: 'DM Serif Display', serif;
    font-size: 2rem;
    color: var(--gold);
    line-height: 1;
    flex-shrink: 0;
    width: 2rem;
  }
  .pillar-title {
    font-family: 'DM Serif Display', serif;
    font-size: 1.2rem;
    color: var(--forest);
    margin-bottom: 0.4rem;
  }
  .pillar-desc {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.05rem;
    color: #5a5a48;
    line-height: 1.65;
  }

  /* Mosaic side */
  .mosaic {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 1rem;
  }
  .mosaic-block {
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    min-height: 180px;
  }
  .mosaic-block:first-child {
    grid-column: 1 / -1;
    min-height: 280px;
    background: linear-gradient(135deg, var(--forest) 0%, var(--forest-light) 100%);
    position: relative;
  }
  .mosaic-block:nth-child(2) {
    background: linear-gradient(135deg, var(--gold) 0%, var(--gold-light) 100%);
    min-height: 200px;
  }
  .mosaic-block:nth-child(3) {
    background: var(--ink);
    min-height: 200px;
  }
  .mosaic-text-overlay {
    text-align: center;
    padding: 2rem;
  }
  .mosaic-big-text {
    font-family: 'DM Serif Display', serif;
    font-style: italic;
    font-size: 2.5rem;
    color: var(--cream);
    line-height: 1.1;
  }
  .mosaic-sub {
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--sage);
    margin-top: 0.8rem;
    display: block;
  }
  .mosaic-stat {
    text-align: center;
    padding: 1.5rem;
  }
  .mosaic-stat-num {
    font-family: 'DM Serif Display', serif;
    font-size: 3rem;
    color: var(--forest);
    line-height: 1;
    display: block;
  }
  .mosaic-stat-label {
    font-size: 0.62rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--forest);
    display: block;
    margin-top: 0.4rem;
    opacity: 0.7;
  }
  .mosaic-quote {
    padding: 2rem;
    text-align: center;
  }
  .mosaic-quote p {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 1rem;
    color: var(--sage);
    line-height: 1.6;
  }

  /* ─── REVIEWS ─── */
  .reviews {
    padding: 8rem 0;
    background: var(--white);
  }
  .reviews-header {
    text-align: center;
    margin-bottom: 4rem;
  }
  .stars {
    font-size: 1.1rem;
    color: var(--gold);
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
    display: block;
  }
  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }
  .review-card {
    padding: 2.5rem;
    background: var(--mist);
    border-left: 2px solid var(--gold);
    position: relative;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.7s, transform 0.7s;
  }
  .review-card.visible { opacity: 1; transform: translateY(0); }
  .review-card::before {
    content: '"';
    font-family: 'DM Serif Display', serif;
    font-size: 5rem;
    color: var(--gold);
    opacity: 0.2;
    position: absolute;
    top: 0.5rem;
    left: 1.5rem;
    line-height: 1;
  }
  .review-text {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.7;
    color: #3a3a2e;
    margin-bottom: 1.5rem;
    position: relative;
    z-index: 1;
  }
  .review-meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .review-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--forest);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'DM Serif Display', serif;
    font-size: 0.9rem;
    color: var(--cream);
    flex-shrink: 0;
  }
  .review-name {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--forest);
    display: block;
  }
  .review-date {
    font-size: 0.65rem;
    color: var(--moss);
    opacity: 0.7;
  }

  /* ─── MENU TEASER ─── */
  .menu-teaser {
    padding: 8rem 0;
    background: var(--forest);
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .menu-teaser-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 60% at 50% 50%, rgba(92,122,78,0.4), transparent);
  }
  .menu-teaser .section-title { color: var(--cream); margin-bottom: 0.5rem; }
  .menu-teaser .section-title em { color: var(--gold-light); }
  .menu-teaser .section-kicker { color: var(--sage); }
  .menu-categories {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 3rem 0;
    position: relative;
  }
  .menu-cat {
    padding: 0.8rem 2rem;
    border: 1px solid rgba(255,255,255,0.15);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sage);
    cursor: pointer;
    transition: all 0.3s;
    border-radius: 2px;
  }
  .menu-cat.active, .menu-cat:hover {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--forest);
  }
  .menu-items {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    text-align: left;
    position: relative;
  }
  .menu-item {
    padding: 1.5rem;
    border-top: 1px solid rgba(255,255,255,0.1);
  }
  .menu-item-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.05rem;
    color: var(--cream);
    margin-bottom: 0.3rem;
  }
  .menu-item-desc {
    font-size: 0.72rem;
    color: var(--sage);
    opacity: 0.8;
    line-height: 1.5;
    margin-bottom: 0.8rem;
  }
  .menu-item-price {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    color: var(--gold);
  }

  /* ─── VISIT ─── */
  .visit {
    padding: 8rem 0;
    background: var(--cream);
  }
  .visit-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 6rem;
    align-items: center;
  }
  .visit-info { }
  .visit-details {
    margin-top: 3rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .visit-detail {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 1rem;
    align-items: start;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(184,150,90,0.2);
  }
  .visit-detail-icon { color: var(--gold); font-size: 0.9rem; margin-top: 0.1rem; }
  .visit-detail-label {
    font-size: 0.62rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--moss);
